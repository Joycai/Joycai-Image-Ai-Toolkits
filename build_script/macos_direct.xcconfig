// Used only by build_macos.sh --distribution direct via XCODE_XCCONFIG_FILE.
// Sandbox enabled; no App Store provisioning or developer certificate.
JOYCAI_RELEASE_ENTITLEMENTS = Runner/Direct.entitlements
ENABLE_APP_SANDBOX = YES
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
// Match Runner and generated Swift-package dependency deployment targets.
MACOSX_DEPLOYMENT_TARGET = 14.0
// Runner-only indirection keeps plugin framework names and identities intact.
JOYCAI_APP_PRODUCT_NAME = Joycai Image AI Toolkits Direct
JOYCAI_APP_BUNDLE_IDENTIFIER = cn.joycai.joycaiImageAiToolkits.direct
